// LowMonitor PC arayüzü (ADR-0031): Canlı, Olaylar, Geçmiş, Süreçler, AI (ADR-0032). Veri tray'deki deck'ten loopback.
// Animasyon/timer yok; yalnız property değişince yeniden çizim.

import { ListView, LineEdit } from "std-widgets.slint";

global Theme {
    out property <color> bg: #101010;
    out property <color> surface: #1c1c1c;
    out property <color> text: #e6e6e6;
    out property <color> dim: #8a8a8a;
    out property <color> accent: #4fc3f7;
    out property <color> accent2: #ba68c8;
    out property <color> warn: #ff7043;
    out property <color> ok: #66bb6a;
    out property <color> disabled: #3a3a3a;
}

// Dil (tray ile aynı ayar: ai.toml `language`); metinler yerinde `Lang.t("Türkçe", "English")`.
export global Lang {
    in property <bool> english;
    pure public function t(tr: string, en: string) -> string {
        return self.english ? en : tr;
    }
}

// Grafik üstünde fare (ADR yok, spek §9): metin Rust'ta (`hover_text`); `rev` yeni veriyle artar,
// fare durağanken de kutucuk güncellenir. Yeniden çizim yalnız fare hareketinde / yeni veride.
export global Hover {
    in property <int> rev;
    pure callback text(int, float, int) -> string;
}

export struct TopRow { name: string, cpu: string, ws: string }
export struct EventRow { time: string, kind: int, name: string, value: string }
export struct GroupRow { name: string, pct: string, tokens: string, fill: float }
export struct SessRow { end: string, project: string, requests: string, tokens: string, top: string }
export struct ProcRow { pid: int, name: string, cpu: string, ws: string, protected: bool, selected: bool }

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 32px;
    width: 96px;
    border-radius: 6px;
    background: root.active ? Theme.surface : transparent;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: root.active ? Theme.accent : Theme.dim;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 5 dk çizgisi (LM spek §9.1): path'ler Rust'ta üretilir (viewbox 300 s × 100), yalnız yeni örnekte değişir.
component Spark inherits Rectangle {
    in property <string> a;
    in property <string> b; // "" = tek çizgi
    in property <color> ca;
    in property <color> cb;
    in property <string> scale; // "" = sabit 0..%100 ölçek, etiket yok
    in property <float> vb: 300; // viewbox genişliği: Canlı 300 s, Geçmiş kova sayısı
    in property <int> kind: -1; // hover sorgusu (`hover_text`); -1 = hover yok
    if root.a != "": Path {
        width: 100%;
        height: 100%;
        commands: root.a;
        viewbox-width: root.vb;
        viewbox-height: 100;
        fit: fill; // varsayılan contain en-boy oranını korur → grafik kartı doldurmaz
        stroke: root.ca;
        stroke-width: 1.5px;
    }
    if root.b != "": Path {
        width: 100%;
        height: 100%;
        commands: root.b;
        viewbox-width: root.vb;
        viewbox-height: 100;
        fit: fill; // varsayılan contain en-boy oranını korur → grafik kartı doldurmaz
        stroke: root.cb;
        stroke-width: 1.5px;
    }
    if root.scale != "": Text {
        // Sol üst: yeni veri sağ kenarda çizilir, etiket çizgiyi örtmesin.
        x: 0;
        y: 0;
        text: root.scale;
        color: Theme.dim;
        font-size: 10px;
    }
    ta := TouchArea { }
    if root.kind >= 0 && ta.has-hover: Rectangle {
        x: clamp(ta.mouse-x, 0, root.width - 1px);
        width: 1px;
        background: Theme.dim;
    }
    if root.kind >= 0 && ta.has-hover: tip := Rectangle {
        property <string> s: Hover.text(root.kind, ta.mouse-x / max(1px, root.width), Hover.rev);
        visible: self.s != "";
        width: t.preferred-width + 12px;
        height: t.preferred-height + 6px;
        // Sağ yarıda imlecin soluna geçer (kart dışına taşmasın)
        x: ta.mouse-x > root.width / 2 ? ta.mouse-x - self.width - 6px : ta.mouse-x + 6px;
        y: 0;
        background: Theme.bg;
        border-color: Theme.disabled;
        border-width: 1px;
        border-radius: 4px;
        t := Text {
            x: 6px;
            y: 3px;
            text: tip.s;
            color: Theme.text;
            font-size: 11px;
        }
    }
}

// Geçmiş kartı: etiket + büyük grafik (Spark, kova sayısı viewbox).
component HistCard inherits Rectangle {
    in property <string> label;
    in property <string> a;
    in property <string> b;
    in property <color> ca: Theme.accent;
    in property <color> cb: Theme.accent2;
    in property <string> scale;
    in property <float> vb;
    in property <int> kind: -1;
    background: Theme.surface;
    border-radius: 8px;
    // Eşit 2×2: tercih/min genişlik içerikten bağımsız (0), yer yalnız stretch ile bölünür.
    // Pencere genişliğine bağlamak binding loop'tu (Slint 1.18 uyarısı, ileride panic).
    preferred-width: 0px;
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-height: 110px;
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Text { text: root.label; color: Theme.dim; font-size: 12px; overflow: elide; }
        Spark {
            vertical-stretch: 1;
            min-height: 60px;
            a: root.a;
            b: root.b;
            ca: root.ca;
            cb: root.cb;
            scale: root.scale;
            vb: root.vb;
            kind: root.kind;
        }
    }
}

component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> live;
    in property <string> path-a;
    in property <string> path-b;
    in property <color> color-a: Theme.accent;
    in property <color> color-b: Theme.accent2;
    in property <string> scale;
    in property <int> kind: -1;
    background: Theme.surface;
    border-radius: 8px;
    min-height: 124px;
    // Eşit genişlik: değer metni uzunluğu kartı büyütmesin (her saniye kayıyordu); HistCard ile aynı.
    preferred-width: 0px;
    min-width: 0px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: root.label; color: Theme.dim; font-size: 12px; }
        Text {
            text: root.live ? root.value : "—";
            color: root.live ? Theme.text : Theme.disabled;
            font-size: 22px;
            overflow: elide;
        }
        Spark {
            height: 56px;
            a: root.path-a;
            b: root.path-b;
            ca: root.live ? root.color-a : Theme.disabled;
            cb: root.live ? root.color-b : Theme.disabled;
            scale: root.scale;
            kind: root.kind;
        }
    }
}

export component MainWindow inherits Window {
    // Tek örnek: ikinci kopya bu başlıkla pencereyi bulup öne getirir.
    title: "LowMonitor";
    background: Theme.bg;
    preferred-width: 760px;
    preferred-height: 580px;
    min-width: 520px;
    min-height: 360px;

    in property <string> status: Lang.t("Bağlanıyor…", "Connecting…");
    in property <bool> connected: false;
    in property <int> lm-state: 0; // 0 = veri yok, 1 = canlı, 2 = LowMonitor servisi yok
    in property <string> lm-cpu;
    in property <string> lm-ram;
    in property <string> lm-disk;
    in property <string> lm-net;
    in property <[float]> lm-cores; // 0..1
    // 5 dk grafikleri (SVG path); disk/ağ ölçeği iki çizginin ortak max'ı
    in property <string> lm-cpu-path;
    in property <string> lm-ram-path;
    in property <string> lm-disk-r-path;
    in property <string> lm-disk-w-path;
    in property <string> lm-net-rx-path;
    in property <string> lm-net-tx-path;
    in property <string> lm-disk-scale;
    in property <string> lm-net-scale;
    in property <[TopRow]> lm-top;
    in property <string> alarms; // "" = aktif alarm yok
    // AI (Claude) kullanımı (ADR-0032): tray'deki deck değişince push eder
    in property <int> ai-state: 0; // 0 = bekleniyor, 1 = veri var, 2 = tray'de veri yok
    in property <string> ai-session;
    in property <string> ai-week;
    in property <int> ai-session-level; // 0 normal, 1 uyarı, 2 kritik, 3 eski
    in property <int> ai-week-level;
    in property <string> ai-note;
    in property <[EventRow]> events; // yeni → eski
    in-out property <int> tab: 0; // 0 = Canlı, 1 = Olaylar, 2 = Geçmiş, 3 = Süreçler, 4 = AI
    // AI raporu (ADR-0032 Faz 5): veri Rust'ta (lowmon-ai report), yalnız sekme açılınca / Yenile ile kurulur
    in-out property <int> ai-view: 2; // 0 = Son oturum, 1 = Bugün, 2 = Bu hafta
    in property <string> ai-rep-status;
    in property <string> ai-rep-sub;
    in property <string> ai-chart-s; // limit çizgileri, viewbox 1000 × 100
    in property <string> ai-chart-w;
    in property <[GroupRow]> ai-groups;
    in property <[SessRow]> ai-sessions;
    callback ai-report(bool); // true = dosyalardan yeniden kur, false = yalnız görünüm değişti
    // Geçmiş (ADR-0005): aralık 0..3 = 1 sa / 6 sa / 24 sa / 7 g; path'ler Rust'ta (viewbox hist-n × 100)
    in-out property <int> hist-span: 0;
    in property <string> hist-status;
    in property <string> hist-range;
    in property <float> hist-n: 600;
    in property <string> hist-cpu-avg;
    in property <string> hist-cpu-max;
    in property <string> hist-ram;
    in property <string> hist-disk-r;
    in property <string> hist-disk-w;
    in property <string> hist-net-rx;
    in property <string> hist-net-tx;
    in property <string> hist-ram-scale;
    in property <string> hist-disk-scale;
    in property <string> hist-net-scale;
    callback query-history(int);
    // Süreçler (LM spek §9.4): tarama Rust'ta, yalnız bu sekme görünürken 2 s'de bir
    in property <[ProcRow]> procs;
    in property <string> proc-status;
    in property <bool> proc-can-kill;
    in property <bool> proc-confirm; // iki aşamalı onay: ilk tık "Emin misin?"
    in-out property <int> proc-sort: 0; // 0 = CPU, 1 = RAM
    callback proc-select(int); // PID
    callback proc-filter-changed(string);
    // Fare liste üzerinde → Rust taramayı atlar, liste kaymaz.
    in-out property <bool> proc-hover;
    callback proc-kill();
    callback proc-sort-changed(int);
    callback tab-changed(int);
    changed tab => { root.tab-changed(self.tab); }
    property <bool> live: root.connected && root.lm-state == 1;

    callback refresh-events();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            Tab { label: Lang.t("Canlı", "Live"); active: root.tab == 0; clicked => { root.tab = 0; } }
            Tab { label: Lang.t("Olaylar", "Events"); active: root.tab == 1; clicked => { root.tab = 1; } }
            Tab { label: Lang.t("Geçmiş", "History"); active: root.tab == 2; clicked => { root.tab = 2; root.query-history(root.hist-span); } }
            Tab { label: Lang.t("Süreçler", "Processes"); active: root.tab == 3; clicked => { root.tab = 3; } }
            Tab { label: "AI"; width: 64px; active: root.tab == 4; clicked => { root.tab = 4; } }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 10px;
                height: 10px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: root.connected ? Theme.ok : Theme.warn;
            }
            Text {
                text: !root.connected ? root.status : root.lm-state == 2 ? Lang.t("LowMonitor servisi yok", "LowMonitor service not running") : root.status;
                color: root.connected && root.lm-state != 2 ? Theme.dim : Theme.warn;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.alarms != "": Rectangle {
            background: #3a1d14;
            border-radius: 6px;
            height: 32px;
            Text {
                x: 12px;
                text: Lang.t("⚠ Aktif alarm: ", "⚠ Active alarm: ") + root.alarms;
                color: Theme.warn;
                font-size: 14px;
                vertical-alignment: center;
                height: parent.height;
                overflow: elide;
            }
        }

        // --- Canlı ---
        if root.tab == 0: VerticalLayout {
            spacing: 12px;
            // AI bandı: yalnız veri varken; renkler taskbar ile aynı (uyarı turuncu, kritik kırmızı, eski gri)
            if root.connected && root.ai-state == 1: Rectangle {
                background: Theme.surface;
                border-radius: 6px;
                height: 32px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 24px;
                    Text { text: "AI"; color: Theme.dim; font-size: 13px; vertical-alignment: center; }
                    for row in [
                        { text: root.ai-session, level: root.ai-session-level },
                        { text: root.ai-week, level: root.ai-week-level },
                    ]: Text {
                        text: row.text;
                        color: row.level == 3 ? Theme.dim : row.level == 2 ? #e5484d : row.level == 1 ? #f0a030 : Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.ai-note; color: Theme.dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Stat { label: Lang.t("CPU  5 dk", "CPU  5 min"); value: root.lm-cpu; live: root.live; path-a: root.lm-cpu-path; kind: 0; }
                Stat { label: Lang.t("RAM  5 dk", "RAM  5 min"); value: root.lm-ram; live: root.live; path-a: root.lm-ram-path; kind: 1; }
                Stat {
                    label: Lang.t("DİSK  B/s", "DISK  B/s");
                    value: root.lm-disk;
                    live: root.live;
                    path-a: root.lm-disk-r-path;
                    path-b: root.lm-disk-w-path;
                    scale: root.lm-disk-scale;
                    kind: 2;
                }
                Stat {
                    label: Lang.t("AĞ  B/s", "NET  B/s");
                    value: root.lm-net;
                    live: root.live;
                    path-a: root.lm-net-rx-path;
                    path-b: root.lm-net-tx-path;
                    color-a: Theme.ok;
                    scale: root.lm-net-scale;
                    kind: 3;
                }
            }
            // Mutlak konum: `for` içeren layout boşken max-width = 0 verir (telefon UI'ı notu).
            bars := Rectangle {
                height: 48px;
                property <length> slot: self.width / max(1, root.lm-cores.length);
                for c[i] in root.lm-cores: Rectangle {
                    x: i * bars.slot;
                    width: bars.slot - 3px;
                    background: Theme.surface;
                    Rectangle {
                        height: parent.height * clamp(c, 0, 1);
                        y: parent.height - self.height;
                        background: root.live ? Theme.accent : Theme.disabled;
                    }
                }
            }
            Text { text: Lang.t("EN ÇOK CPU", "TOP CPU"); color: Theme.dim; font-size: 12px; }
            Rectangle {
                height: 5 * 22px;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: start;
                    spacing: 2px;
                    for t in root.lm-top: HorizontalLayout {
                        spacing: 8px;
                        Text { text: t.name; color: root.live ? Theme.text : Theme.disabled; font-size: 15px; overflow: elide; horizontal-stretch: 1; }
                        Text { text: t.cpu; color: root.live ? Theme.text : Theme.disabled; font-size: 15px; width: 72px; horizontal-alignment: right; }
                        Text { text: t.ws; color: Theme.dim; font-size: 15px; width: 96px; horizontal-alignment: right; }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        // --- Geçmiş: hazır aralıklar, bitiş = şimdi; yenileme yalnız tıklamayla (timer yok) ---
        if root.tab == 2: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 6px;
                for l[i] in [Lang.t("1 sa", "1 h"), Lang.t("6 sa", "6 h"), Lang.t("24 sa", "24 h"), Lang.t("7 g", "7 d")]: Tab {
                    label: l;
                    width: 64px;
                    active: root.hist-span == i;
                    clicked => {
                        root.hist-span = i;
                        root.query-history(i);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.hist-status != "" ? root.hist-status : root.hist-range;
                    color: Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                // Max önce (soluk), ortalama üstte
                HistCard { label: Lang.t("CPU  ort. / en yüksek", "CPU  avg / max"); a: root.hist-cpu-max; ca: #2f6f8a; b: root.hist-cpu-avg; cb: Theme.accent; vb: root.hist-n; kind: 10; }
                HistCard { label: "RAM"; a: root.hist-ram; scale: root.hist-ram-scale; vb: root.hist-n; kind: 11; }
            }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                HistCard { label: Lang.t("DİSK  R / W", "DISK  R / W"); a: root.hist-disk-r; b: root.hist-disk-w; scale: root.hist-disk-scale; vb: root.hist-n; kind: 12; }
                HistCard { label: Lang.t("AĞ  ↓ / ↑", "NET  ↓ / ↑"); a: root.hist-net-rx; b: root.hist-net-tx; ca: Theme.ok; scale: root.hist-net-scale; vb: root.hist-n; kind: 13; }
            }
        }

        // --- Süreçler: tüm süreçler, CPU/RAM sıralı; sonlandırma iki aşamalı onayla (spek §10) ---
        if root.tab == 3: VerticalLayout {
            spacing: 6px;
            LineEdit {
                placeholder-text: Lang.t("Ara: ad ya da PID", "Search: name or PID");
                font-size: 14px;
                edited(t) => { root.proc-filter-changed(t); }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                Text { text: Lang.t("AD", "NAME"); color: Theme.dim; font-size: 12px; horizontal-stretch: 1; }
                Text { text: "PID"; color: Theme.dim; font-size: 12px; width: 64px; horizontal-alignment: right; }
                Text {
                    text: root.proc-sort == 0 ? "CPU ▾" : "CPU";
                    color: root.proc-sort == 0 ? Theme.accent : Theme.dim;
                    font-size: 12px;
                    width: 72px;
                    horizontal-alignment: right;
                    TouchArea { clicked => { root.proc-sort = 0; root.proc-sort-changed(0); } }
                }
                Text {
                    text: root.proc-sort == 1 ? "RAM ▾" : "RAM";
                    color: root.proc-sort == 1 ? Theme.accent : Theme.dim;
                    font-size: 12px;
                    width: 88px;
                    horizontal-alignment: right;
                    TouchArea { clicked => { root.proc-sort = 1; root.proc-sort-changed(1); } }
                }
            }
            // Üst TouchArea yalnız hover için (tıklamalar satırlara iner).
            hover := TouchArea {
                vertical-stretch: 1;
                changed has-hover => { root.proc-hover = self.has-hover; }
            ListView {
                width: 100%;
                height: 100%;
                for p in root.procs: Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: p.selected ? Theme.surface : transparent;
                    TouchArea { clicked => { root.proc-select(p.pid); } }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Text {
                            text: p.name;
                            color: p.protected ? Theme.dim : Theme.text;
                            font-size: 14px;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text { text: p.pid; color: Theme.dim; font-size: 13px; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: p.cpu; color: Theme.text; font-size: 14px; width: 72px; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: p.ws; color: Theme.dim; font-size: 14px; width: 88px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
            }
            }
            HorizontalLayout {
                spacing: 8px;
                height: 32px;
                Text {
                    text: (root.proc-hover ? Lang.t("⏸ sabit  ·  ", "⏸ paused  ·  ") : "") + root.proc-status;
                    color: root.proc-confirm ? Theme.warn : Theme.dim;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.proc-can-kill: Tab {
                    width: 128px;
                    label: root.proc-confirm ? Lang.t("Evet, sonlandır", "Yes, end it") : Lang.t("Sonlandır", "End process");
                    active: root.proc-confirm;
                    clicked => { root.proc-kill(); }
                }
            }
        }

        // --- AI: limit çizgisi + token dökümü + oturumlar (yalnız sayılar, araç grubu ve proje klasörü adları) ---
        if root.tab == 4: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 6px;
                for l[i] in [Lang.t("Son oturum", "Last session"), Lang.t("Bugün", "Today"), Lang.t("Bu hafta", "This week")]: Tab {
                    label: l;
                    active: root.ai-view == i;
                    clicked => {
                        root.ai-view = i;
                        root.ai-report(false);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.ai-rep-status != "" ? root.ai-rep-status : root.ai-rep-sub;
                    color: Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Tab { label: Lang.t("Yenile", "Refresh"); width: 72px; active: true; clicked => { root.ai-report(true); } }
            }
            HistCard {
                label: Lang.t("LİMİT %   oturum (mavi) / hafta (mor)", "LIMIT %   session (blue) / week (purple)");
                a: root.ai-chart-w;
                ca: Theme.accent2;
                b: root.ai-chart-s;
                cb: Theme.accent;
                vb: 1000;
                vertical-stretch: 0;
                height: 150px;
            }
            Text { text: Lang.t("TOKEN DÖKÜMÜ  (efektif = girdi + 0,1×önbellek okuma + 2×önbellek yazma + 5×çıktı)", "TOKEN BREAKDOWN  (effective = input + 0.1×cache read + 2×cache write + 5×output)"); color: Theme.dim; font-size: 12px; overflow: elide; }
            ListView {
                vertical-stretch: 1;
                for g in root.ai-groups: HorizontalLayout {
                    spacing: 10px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text { text: g.name; color: Theme.text; font-size: 14px; width: 170px; overflow: elide; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 18px;
                        Rectangle {
                            y: 4px;
                            height: 10px;
                            border-radius: 3px;
                            background: Theme.surface;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(g.fill, 0, 1);
                                border-radius: 3px;
                                background: Theme.accent;
                            }
                        }
                    }
                    Text { text: g.pct; color: Theme.text; font-size: 14px; width: 56px; horizontal-alignment: right; vertical-alignment: center; }
                    Text { text: g.tokens; color: Theme.dim; font-size: 14px; width: 72px; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: Lang.t("BİTİŞ", "ENDED"); color: Theme.dim; font-size: 12px; width: 88px; }
                Text { text: Lang.t("PROJE", "PROJECT"); color: Theme.dim; font-size: 12px; horizontal-stretch: 1; }
                Text { text: Lang.t("İSTEK", "REQ"); color: Theme.dim; font-size: 12px; width: 48px; horizontal-alignment: right; }
                Text { text: Lang.t("EFEKTİF", "EFF."); color: Theme.dim; font-size: 12px; width: 64px; horizontal-alignment: right; }
                Text { text: Lang.t("EN BÜYÜK GRUP", "LARGEST GROUP"); color: Theme.dim; font-size: 12px; width: 190px; }
            }
            ListView {
                vertical-stretch: 1;
                for s in root.ai-sessions: HorizontalLayout {
                    spacing: 12px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text { text: s.end; color: Theme.dim; font-size: 14px; width: 88px; }
                    Text { text: s.project; color: Theme.text; font-size: 14px; horizontal-stretch: 1; overflow: elide; }
                    Text { text: s.requests; color: Theme.text; font-size: 14px; width: 48px; horizontal-alignment: right; }
                    Text { text: s.tokens; color: Theme.text; font-size: 14px; width: 64px; horizontal-alignment: right; }
                    Text { text: s.top; color: Theme.dim; font-size: 14px; width: 190px; overflow: elide; }
                }
            }
        }

        // --- Olaylar (son 24 saat + canlı) ---
        if root.tab == 1: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                Text { text: Lang.t("SON 24 SAAT", "LAST 24 HOURS"); color: Theme.dim; font-size: 12px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Tab { label: Lang.t("Yenile", "Refresh"); active: true; clicked => { root.refresh-events(); } }
            }
            if root.events.length == 0: Text {
                text: root.connected ? Lang.t("Olay yok", "No events") : "—";
                color: Theme.dim;
                font-size: 14px;
            }
            ListView {
                vertical-stretch: 1;
                for e in root.events: HorizontalLayout {
                    spacing: 12px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Text { text: e.time; color: Theme.dim; font-size: 14px; width: 150px; }
                    Text {
                        text: e.kind == 0 ? "ALARM" : e.kind == 1 ? Lang.t("temizlendi", "cleared") : Lang.t("sistem", "system");
                        color: e.kind == 0 ? Theme.warn : e.kind == 1 ? Theme.ok : Theme.dim;
                        font-size: 14px;
                        width: 88px;
                    }
                    Text { text: e.name; color: Theme.text; font-size: 14px; horizontal-stretch: 1; overflow: elide; }
                    Text { text: e.value; color: Theme.dim; font-size: 14px; width: 96px; horizontal-alignment: right; }
                }
            }
        }
    }
}
